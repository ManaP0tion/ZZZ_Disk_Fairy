{
  "manifest_version": 3,
  "name": "ZZZ 디스크 어드바이저",
  "version": "0.1.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "HoYoLAB 전적 페이지에서 에이전트를 열면 장착한 디스크를 세팅 시트 기준으로 평가합니다.",
  "content_scripts": [
    {
      "matches": [
        "https://act.hoyolab.com/app/zzz-game-record/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://act.hoyolab.com/app/zzz-game-record/*"
      ],
      "js": [
        "benchmark.js",
        "suit-icons.js",
        "evaluator.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}