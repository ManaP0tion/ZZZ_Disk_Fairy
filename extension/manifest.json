{
  "manifest_version": 3,
  "name": "ZZZ 디스크 페어리",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZZZ 디스크 페어리"
  },
  "description": "HoYoLAB 전적 페이지에서 에이전트를 열면 장착한 디스크를 세팅 시트 기준으로 평가합니다.",
  "host_permissions": [
    "https://act.hoyolab.com/app/zzz-game-record/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["report.html"],
      "matches": ["https://act.hoyolab.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://act.hoyolab.com/app/zzz-game-record/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://act.hoyolab.com/app/zzz-game-record/*"
      ],
      "js": [
        "data/benchmark.js",
        "data/suit-icons.js",
        "data/engine-icons.js",
        "evaluator.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}